<Project Sdk="Godot.NET.Sdk/4.5.1" InitialTargets="CheckDependencyPaths">
    <Import Project=".\Sts2PathDiscovery.props"/>
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable> <!--Makes code analysis regarding null values stricter.-->
        <Publicize>True</Publicize> <!--Allows access to originally private/protected members but may (unlikely to) cause errors.-->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
        <PathMap>$(AppOutputBase)=.\</PathMap>
        <GodotDisabledSourceGenerators>GodotPluginsInitializer</GodotDisabledSourceGenerators>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Diasble architecture mismatch warning; mods are ideally built for all platforms (MSIL)
             while your local StS2 version will be for your specific platform. -->
        <NoWarn>$(NoWarn);MSB3270</NoWarn>
    </PropertyGroup>

    <!-- Build variant (docs/build-variants.md): Local (default, dev machine) | Nightly (CI main) | Release (CI v* tags).
         Each variant is its own mod (manifest id, assembly, root namespace, res:// root, loc keys) so they can be
         installed side by side without clobbering each other. -->
    <PropertyGroup>
        <ModVariant Condition="'$(ModVariant)' == ''">Local</ModVariant>
        <ModBaseId>$(MSBuildProjectName)</ModBaseId>
        <ModId Condition="'$(ModVariant)' == 'Release'">$(ModBaseId)</ModId>
        <ModId Condition="'$(ModVariant)' != 'Release'">$(ModBaseId)$(ModVariant)</ModId>
        <ModDisplayName Condition="'$(ModVariant)' == 'Release'">$(ModBaseId)</ModDisplayName>
        <ModDisplayName Condition="'$(ModVariant)' != 'Release'">$(ModBaseId) ($(ModVariant))</ModDisplayName>
        <AssemblyName>$(ModId)</AssemblyName>
        <RootNamespace>$(ModId)</RootNamespace>
        <DefineConstants>$(DefineConstants);MOD_VARIANT_$(ModVariant.ToUpperInvariant())</DefineConstants>
        <!-- The pck is packed by our own target below (needs the staged asset folder). -->
        <PckPackerEnabled>false</PckPackerEnabled>
    </PropertyGroup>

    <!-- No local game (e.g. GitHub Actions): compile against reference stubs and pack the .pck without Godot.
         Keep the stub version in sync with the game version the mod targets. -->
    <PropertyGroup>
        <UseSts2RefAssemblies Condition="'$(UseSts2RefAssemblies)' == '' And !Exists('$(Sts2DataDir)/sts2.dll')">true</UseSts2RefAssemblies>
    </PropertyGroup>

    <ItemGroup Condition="'$(UseSts2RefAssemblies)' == 'true'">
        <PackageReference Include="BSchneppe.Sts2.ReferenceAssemblies" Version="0.111.0-beta-41cef1ea" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseSts2RefAssemblies)' != 'true'" >
        <Reference Include="0Harmony">
            <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="sts2">
            <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup Condition="$(Publicize)">
        <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="All"/>
        <Publicize Include="sts2" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Alchyr.Sts2.BaseLib" Version="*" PrivateAssets="All"/>
        <PackageReference Include="Alchyr.Sts2.ModAnalyzers" Version="*" />
        <!-- Packs RunePriest/ into the .pck without Godot (see PackModPck). -->
        <PackageReference Include="BSchneppe.StS2.PckPacker" Version="0.1.1" PrivateAssets="All" />
        <AdditionalFiles Include="RunePriest/localization/**/*.json"/> <!-- Used by analyzer -->
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="RunePriest/**" />
        <Compile Remove=".decompiled/**" />
        <Compile Remove="materials/**" />
        <Compile Remove="shaders/**" />
        <Compile Remove="images/**" />
        <EmbeddedResource Remove="RunePriest/**" />
        <EmbeddedResource Remove="materials/**" />
        <EmbeddedResource Remove="shaders/**" />
        <EmbeddedResource Remove="images/**" />
    </ItemGroup>

    <ItemGroup>
        <None Condition="Exists('Directory.Build.props')" Include="Directory.Build.props"/>
        <None Include=".gitignore" />
        <None Include="RunePriest.json" />
        <None Include="project.godot"/>
        <None Include="RunePriest/**" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="RunePriest\images\card_portraits\big\" />
      <Folder Include="RunePriest\images\powers\big\" />
      <Folder Include="RunePriest\images\relics\big\" />
    </ItemGroup>
    
    <Target Name="CheckDependencyPaths" Condition="'$(UseSts2RefAssemblies)' != 'true'">
        <Error
                Text=" Slay the Spire 2 data not found at path '$(Sts2DataDir)'"
                Condition="'$(Sts2DataDir)' == '' or !Exists('$(Sts2DataDir)')" />
    </Target>

    <Target Name="UpdateDependencyVersions" BeforeTargets="BeforeBuild" Condition="Exists('.godot/mono/temp/obj/project.assets.json')">
        <PropertyGroup>
            <ManifestPath>$(MSBuildProjectName).json</ManifestPath>
        </PropertyGroup>

        <PropertyGroup>
            <NuGetData>$([System.IO.File]::ReadAllText(".godot/mono/temp/obj/project.assets.json"))</NuGetData>
            <ActiveBaseLibVersion>$([System.Text.RegularExpressions.Regex]::Match($(NuGetData), '"Alchyr.Sts2.BaseLib\/([^"]*)').Result('$1'))</ActiveBaseLibVersion>
            <OldContent>$([System.IO.File]::ReadAllText($(ManifestPath)))</OldContent>
            <NewContent>$([System.Text.RegularExpressions.Regex]::Replace($(OldContent), '("id":\s*"BaseLib",\s*"min_version":\s*")[^"]*', '${1}$(ActiveBaseLibVersion)'))</NewContent>
        </PropertyGroup>

        <WriteLinesToFile
                Condition="'$(OldContent)' != '$(NewContent)'"
                File="$(ManifestPath)"
                Lines="$(NewContent)"
                Overwrite="true"
                Encoding="UTF-8" />

        <Message Condition="'$(OldContent)' != '$(NewContent)'"
                 Text="Updated BaseLib dependency version in mod manifest json to version $(BaseLibVersion)"
                 Importance="high" />
    </Target>
    
    <!-- ===== Build variants (docs/build-variants.md) =====
         Non-release variants compile rewritten copies of the sources (RunePriest.RunePriestCode -> <ModId>.RunePriestCode,
         so BaseLib's model ID prefix and Godot script paths differ) and stage assets/loc with RUNEPRIEST -> <MODID> keys,
         packed under res://<ModId>/. #line directives keep diagnostics and the debugger on the original files. -->
    <UsingTask TaskName="StageModVariantFiles" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
            <SourceRoot Required="true" />
            <OutputRoot Required="true" />
            <OldId Required="true" />
            <NewId Required="true" />
            <LineDirectives ParameterType="System.Boolean" />
            <Prune ParameterType="System.Boolean" />
            <Outputs ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System.Collections.Generic" />
            <Using Namespace="System.IO" />
            <Using Namespace="System.Linq" />
            <Using Namespace="System.Text" />
            <Using Namespace="System.Text.RegularExpressions" />
            <Code Type="Fragment" Language="cs"><![CDATA[
            // Files under SourceRoot are copied to OutputRoot (rewriting .cs/.json); anything else passes through untouched.
            string Dir(string d) => Path.GetFullPath(d).TrimEnd('/', '\\') + Path.DirectorySeparatorChar;
            var src = Dir(SourceRoot);
            var dst = Dir(OutputRoot);
            var ns = new Regex(@"\b" + Regex.Escape(OldId) + @"\.RunePriestCode\b");
            var key = new Regex(@"(?<![A-Za-z])" + Regex.Escape(OldId.ToUpperInvariant()) + @"(?=[-_])");
            var res = "res://" + OldId + "/";
            var written = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            var outputs = new List<ITaskItem>();
            foreach (var item in Files)
            {
                var path = item.GetMetadata("FullPath");
                if (!path.StartsWith(src, StringComparison.OrdinalIgnoreCase)) { outputs.Add(item); continue; }
                var target = dst + path.Substring(src.Length);
                Directory.CreateDirectory(Path.GetDirectoryName(target));
                byte[] bytes;
                switch (Path.GetExtension(path).ToLowerInvariant())
                {
                    case ".cs":
                        var code = ns.Replace(File.ReadAllText(path), NewId + ".RunePriestCode");
                        if (LineDirectives) code = "#line 1 \"" + path + "\"\n" + code;
                        bytes = new UTF8Encoding(false).GetBytes(code);
                        break;
                    case ".json":
                        var json = key.Replace(File.ReadAllText(path), NewId.ToUpperInvariant()).Replace(res, "res://" + NewId + "/");
                        bytes = new UTF8Encoding(false).GetBytes(json);
                        break;
                    default:
                        bytes = File.ReadAllBytes(path);
                        break;
                }
                if (!File.Exists(target) || !File.ReadAllBytes(target).SequenceEqual(bytes)) File.WriteAllBytes(target, bytes);
                written.Add(target);
                var output = new TaskItem(target);
                item.CopyMetadataTo(output);
                outputs.Add(output);
            }
            if (Prune && Directory.Exists(dst))
                foreach (var stale in Directory.GetFiles(dst, "*", SearchOption.AllDirectories).Where(f => !written.Contains(Path.GetFullPath(f))))
                    File.Delete(stale);
            Outputs = outputs.ToArray();
            ]]></Code>
        </Task>
    </UsingTask>

    <UsingTask TaskName="WriteModVariantManifest" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <Template Required="true" />
            <OutputFile Required="true" />
            <ModId Required="true" />
            <ModName Required="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System.IO" />
            <Using Namespace="System.Text.RegularExpressions" />
            <Code Type="Fragment" Language="cs"><![CDATA[
            // The first "id"/"name" keys are the manifest's own (dependencies come later).
            var json = File.ReadAllText(Template);
            foreach (var (field, value) in new[] { ("id", ModId), ("name", ModName) })
            {
                var rule = new Regex("(\"" + field + "\"\\s*:\\s*\")[^\"]*\"");
                if (!rule.IsMatch(json)) { Log.LogError("Mod manifest " + Template + " has no \"" + field + "\" field."); return false; }
                json = rule.Replace(json, m => m.Groups[1].Value + value + "\"", 1);
            }
            Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
            if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != json) File.WriteAllText(OutputFile, json);
            ]]></Code>
        </Task>
    </UsingTask>

    <Target Name="ModVariantPaths">
        <Error Condition="'$(ModVariant)' != 'Local' And '$(ModVariant)' != 'Nightly' And '$(ModVariant)' != 'Release'"
               Text="ModVariant must be Local, Nightly or Release (got '$(ModVariant)')." />
        <PropertyGroup>
            <ModStagingDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'variant', '$(ModId)').Replace('\', '/'))</ModStagingDir>
            <ModAssetStagingDir>$(ModStagingDir)assets/</ModAssetStagingDir>
            <ModPckPath>$(TargetDir)$(ModId).pck</ModPckPath>
            <ModManifestPath>$(ModStagingDir)$(ModId).json</ModManifestPath>
            <ModPackageDir>$(TargetDir)package/$(ModId)/</ModPackageDir>
        </PropertyGroup>
    </Target>

    <Target Name="StageModVariantSources" BeforeTargets="CoreCompile" DependsOnTargets="ModVariantPaths"
            Condition="'$(ModId)' != '$(ModBaseId)' And '$(DesignTimeBuild)' != 'true'">
        <StageModVariantFiles Files="@(Compile)" SourceRoot="$(MSBuildProjectDirectory)/$(ModBaseId)Code/"
                              OutputRoot="$(ModStagingDir)$(ModBaseId)Code/" OldId="$(ModBaseId)" NewId="$(ModId)"
                              LineDirectives="true" Prune="true">
            <Output TaskParameter="Outputs" ItemName="_ModVariantCompile" />
        </StageModVariantFiles>
        <ItemGroup>
            <Compile Remove="@(Compile)" />
            <Compile Include="@(_ModVariantCompile)" />
        </ItemGroup>
    </Target>

    <Target Name="StageModVariantAssets" BeforeTargets="CoreCompile" DependsOnTargets="ModVariantPaths"
            Condition="'$(DesignTimeBuild)' != 'true'">
        <ItemGroup>
            <_ModAssetSource Include="$(ModBaseId)/**" Exclude="$(ModBaseId)/**/*.import;$(ModBaseId)/**/.DS_Store" />
        </ItemGroup>
        <StageModVariantFiles Files="@(_ModAssetSource)" SourceRoot="$(MSBuildProjectDirectory)/$(ModBaseId)/"
                              OutputRoot="$(ModAssetStagingDir)" OldId="$(ModBaseId)" NewId="$(ModId)" Prune="true">
            <Output TaskParameter="Outputs" ItemName="_ModStagedAsset" />
        </StageModVariantFiles>
        <!-- Lets PackModPck notice deleted assets. -->
        <WriteLinesToFile File="$(ModStagingDir)assets.list" Lines="@(_ModStagedAsset)" Overwrite="true" WriteOnlyWhenDifferent="true" />
        <ItemGroup>
            <AdditionalFiles Remove="$(ModBaseId)/localization/**/*.json" />
            <AdditionalFiles Include="$(ModAssetStagingDir)localization/**/*.json" />
        </ItemGroup>
    </Target>

    <Target Name="PackModPck" DependsOnTargets="ModVariantPaths;StageModVariantAssets"
            Inputs="$(ModStagingDir)assets.list;@(_ModStagedAsset)" Outputs="$(ModPckPath)">
        <PropertyGroup>
            <_ModDotnet>$(DOTNET_HOST_PATH)</_ModDotnet>
            <_ModDotnet Condition="'$(_ModDotnet)' == ''">dotnet</_ModDotnet>
        </PropertyGroup>
        <!-- The packer targets net9.0; roll forward so a newer-only runtime (e.g. .NET 10) can run it. -->
        <Exec Command="&quot;$(_ModDotnet)&quot; &quot;$(_PckPackerToolDir)StS2PckPacker.dll&quot; &quot;$(ModAssetStagingDir)&quot; &quot;$(ModId)&quot; &quot;$(ModPckPath)&quot;"
              EnvironmentVariables="DOTNET_ROLL_FORWARD=Major" IgnoreExitCode="true" ConsoleToMSBuild="true">
            <Output TaskParameter="ExitCode" PropertyName="_ModPckExitCode" />
            <Output TaskParameter="ConsoleOutput" PropertyName="_ModPckOutput" />
        </Exec>
        <Error Condition="'$(_ModPckExitCode)' == '2'"
               Text="The PCK packer can't pack some files in $(ModBaseId)/ (e.g. .tscn/.tres); build them in code instead. $(_ModPckOutput)" />
        <Error Condition="'$(_ModPckExitCode)' != '0'" Text="PCK packing failed (exit code $(_ModPckExitCode)): $(_ModPckOutput)" />
        <Message Text="Packed $(ModPckPath) (res://$(ModId)/)" Importance="high" />
    </Target>

    <!-- bin/<cfg>/package/<ModId>/ is the installable mod folder (CI zips it). -->
    <Target Name="AssembleModPackage" AfterTargets="Build" DependsOnTargets="ModVariantPaths;PackModPck">
        <WriteModVariantManifest Template="$(MSBuildProjectDirectory)/$(ModBaseId).json" OutputFile="$(ModManifestPath)"
                                 ModId="$(ModId)" ModName="$(ModDisplayName)" />
        <Copy SourceFiles="$(TargetPath);$(ModPckPath);$(ModManifestPath)" DestinationFolder="$(ModPackageDir)" SkipUnchangedFiles="true" />
        <Message Text="$(ModDisplayName) [$(ModId)] -> $(ModPackageDir)" Importance="high" />
    </Target>

    <Target Name="CopyToModsFolderOnBuild" AfterTargets="AssembleModPackage" Condition="'$(UseSts2RefAssemblies)' != 'true'">
        <ItemGroup>
            <_ModPackageFile Include="$(ModPackageDir)*" />
        </ItemGroup>
        <Copy SourceFiles="@(_ModPackageFile);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ModsPath)$(ModId)/" />
        <Message Text="Installed $(ModDisplayName) to $(ModsPath)$(ModId)/" Importance="high" />
    </Target>
</Project>